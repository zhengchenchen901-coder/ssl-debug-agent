REMOTE_DEBUG_HOST=example.com
REMOTE_DEBUG_PORT=22
REMOTE_DEBUG_USER=app
REMOTE_DEBUG_PRIVATE_KEY_PATH=C:\Users\you\.ssh\id_ed25519
REMOTE_DEBUG_AGENT_PORT=4343
# Final deliverables only. In a source checkout, defaults to <project-root>/output.
# Set an absolute path for installed plugins; restart the Manager after changing it.
# REMOTE_DEBUG_OUTPUT_DIR=/absolute/path/to/ssl-debug-agent/output
# REMOTE_DEBUG_PRIVATE_KEY_PASSPHRASE=
# REMOTE_DEBUG_AUDIT_LOG=C:\path\to\remote-debug-audit.jsonl
# REMOTE_DEBUG_LOG_PROJECTS={"be":{"root":"/home/github/app","directories":["/home/github/app/logs"]}}
# Optional background log task ceilings (CPU is % of one core; rates are bytes/s).
# REMOTE_DEBUG_LOG_JOB_LIMITS={"cpuPercent":20,"readBytesPerSecond":2097152,"processBytesPerSecond":4194304,"maxJobTimeoutMs":7200000,"rssLimitBytes":201326592}
# Shared remote host pools (1000 CPU millicores = one core); restart Manager after editing.
# Domains map instance IDs to shared host/container resource scopes; default is SSH host:port.
# REMOTE_DEBUG_RESOURCE_POLICY={"cpuMilliCores":1000,"protectedCpuMilliCores":200,"controlCpuMilliCores":50,"domains":{"default":"production","test-server":"test"}}
# Optional single-worker source roots as a JSON object, for example {"be":"/home/github/app"}.
# Multi-instance setups should configure sourceRoots in .remote-debug/instances.json instead.
# REMOTE_DEBUG_SOURCE_ROOTS={"be":"/home/github/app"}
# REMOTE_DEBUG_APPROVED_COMMANDS=0
# REMOTE_DEBUG_COMMAND_REVIEW_AUTO_EXECUTE=0
# REMOTE_DEBUG_COMMAND_REVIEW_REFRESH=0
# REMOTE_DEBUG_COMMAND_REVIEW_CONFIG_PATH=C:\path\to\command-review.json
# REMOTE_DEBUG_APPROVED_EXECUTION_TIMEOUT_MS=300000
# REMOTE_DEBUG_APPROVED_EXECUTION_MAX_TIMEOUT_MS=900000
# REMOTE_DEBUG_SSH_KEEPALIVE_INTERVAL_MS=15000
# REMOTE_DEBUG_SSH_KEEPALIVE_COUNT_MAX=3
# REMOTE_DEBUG_SSH_MAX_BUSINESS_CHANNELS=4
# MongoDB reads use the bounded read-only tool. Writes remain disabled unless
# writeEnabled is explicitly true and both allowlists are configured.
# REMOTE_DEBUG_MONGODB_CONFIG={"enabled":true,"configPath":"/home/app/config.json","driverPath":"/home/app/node_modules/mongodb","configProfile":"production","uriKey":"url","database":"yennefer","writeEnabled":true,"allowedDatabases":["yennefer"],"allowedCollections":["restaurant_members"],"rollbackRoot":"/tmp/remote-debug-agent/mutations","maxAffectedDocuments":100}
# Copy trusted server host fingerprints from your server console/admin, not an unverified scan.
REMOTE_DEBUG_SSH_HOST_KEY_FINGERPRINTS=[]
# Optional owner-only credential file; default: <data-dir>/.runtime/http-auth.json.
# REMOTE_DEBUG_AUTH_FILE=C:\Users\you\RemoteDebugAgent\.runtime\http-auth.json
# Optional MCP-only context attachment. Set locally to the same owner-only file
# to share/recover references after restart; never paste this file into chat.
# macOS Keychain is required; Windows/Linux have no credential adapter yet.
# REMOTE_DEBUG_PRIVACY_CONTEXT_FILE=/Users/you/.remote-debug-agent/.private/contexts/<contextId>.json

# New bulk receipts use a dedicated database on the same deployment.
# Configure sandboxDatabase / sandboxManagementProfile in REMOTE_DEBUG_MONGODB_CONFIG.
# The management profile must use a separate sandbox-only MongoDB account.

# Optional external executor retirement authority for legacy-risk replacement.
# Provision only after a trusted external issuer actually retires all old paths.
# Signature verification does not perform SSH/MongoDB credential/session migration.
# REMOTE_DEBUG_EXECUTOR_TRUST_FILE=/absolute/owner-controlled/authority.json
# REMOTE_DEBUG_EXECUTOR_RECEIPT_DIRECTORY=/absolute/owner-controlled/retirement-receipts

      "content": "import { Entity, model, property } from \"@loopback/repository\";\nimport { getJsonSchema } from \"@loopback/repository-json-schema\";\nimport { ObjectId } from \"bson\";\nimport { JsonSchemaRedefined } from \"../constants/type.constant\";\nimport { Address, AddressJsonSchema } from \"./abstract/address.entity\";\nimport { PicVersion } from \"./abstract/pic-version.entity\";\n\n@model()\nexport class CustomerPrivate extends Entity {\n  // *********************\n  // Key [REDACTED]\n  // *********************\n\n  @property({\n    type: \"string\",\n    id: true,\n    generated: true,\n  })\n  public _id?: ObjectId;\n\n  // *********************\n  // [REDACTED]\n  // *********************\n\n  // 关联餐厅\n  // @property({\n  //   type: \"string\",\n  //   required: true,\n  // })\n  // public belonged_restaurant: string;\n  @property({\n    type: \"string\",\n    required: true,\n  })\n  public belonged_group: string;\n  @property({\n    type: \"array\",\n    itemType: \"string\", // ✅ 显式指定数组元素类型\n  })\n  public restaurant_member_ids?: string[];\n\n  @property({ type: \"object\" })\n  public customer_avatar?: PicVersion;\n\n  // 用户ID（匿名提交为null）\n  @property({\n    type: \"object\",\n  })\n  public customer_id?: ObjectId;\n\n  @property({\n    type: \"string\",\n    jsonSchema: {\n      enum: [\"0\", \"1\", \"2\"],\n    },\n  })\n  public customer_gender?: string;\n\n  @property({\n    type: \"string\",\n  })\n  public customer_first_name?: string;\n\n  @property({\n    type: \"string\",\n  })\n  public remark?: string;\n\n  @property({\n    type: \"string\",\n  })\n  public customer_last_name?: string;\n\n  @property({\n    type: \"string\",\n  })\n  public customer_phone?: string;\n\n  @property({\n    type: \"string\",\n  })\n  public customer_phone_prefix?: string;\n\n  @property({\n    type: \"array\",\n    itemType: \"string\", // 显式指定数组元素类型\n  })\n  public addtional_phones?: string[];\n\n  @property({\n    type: \"string\",\n  })\n  public customer_email?: string;\n\n  //是否接受营销\n  // @property({\n  //   type: \"boolean\",\n  // })\n  // public is_receiveed_marketing?: boolean;\n\n  @property({\n    type: \"string\",\n    jsonSchema: {\n      format: \"date-time\",\n    },\n  })\n  public customer_birth?: Date;\n\n  @property.array(Address, {\n    jsonSchema: {\n      type: \"array\",\n      items: {\n        default: AddressJsonSchema.properties.default,\n        first_name: AddressJsonSchema.properties.first_name,\n        last_name: AddressJsonSchema.properties.last_name,\n        phone: AddressJsonSchema.properties.phone,\n        phone_prefix: AddressJsonSchema.properties.phone_prefix,\n        country: AddressJsonSchema.properties.country,\n        state: AddressJsonSchema.properties.state,\n        city: AddressJsonSchema.properties.city,\n        region: AddressJsonSchema.properties.region,\n        home_number: AddressJsonSchema.properties.home_number,\n        street: AddressJsonSchema.properties.street,\n        details: AddressJsonSchema.properties.details,\n        code: AddressJsonSchema.properties.code,\n        google_map_place_id: AddressJsonSchema.properties.google_map_place_id,\n        google_map_formatted_address:\n          AddressJsonSchema.properties.google_map_formatted_address,\n        google_map_lat: AddressJsonSchema.properties.google_map_lat,\n        google_map_lng: AddressJsonSchema.properties.google_map_lng,\n      },\n    },\n  })\n  public customer_address?: Array<Address>;\n\n  @property({ type: \"string\" })\n  public customer_language?: string;\n\n  @property({\n    type: \"array\",\n    itemType: \"string\", // 使用itemType指定元素类型\n    default: [], // 直接定义默认值\n  })\n  public allergens?: string[];\n\n  //其他特征\n  @property({\n    type: \"array\",\n    itemType: \"string\", // 使用itemType指定元素类型\n    default: [], // 直接定义默认值\n  })\n  public others?: string[];\n\n  @property({\n    type: \"string\",\n    default: \"\", // 直接定义默认值\n  })\n  public prefer_food_drinks?: string;\n\n  @property({\n    type: \"boolean\",\n    default: false, // 直接定义默认值\n  })\n  public is_deleted?: boolean;\n  //是否接受营销\n  @property({\n    type: \"boolean\",\n  })\n  public is_marketing?: boolean;\n\n  @property({\n    type: \"string\",\n    default: \"\", // 直接定义默认值\n  })\n  public vip_label?: string;\n\n  @property.array(Object)\n  public vip_levels?: Array<{\n    group_id: string;\n    vip_level_id: string;\n  }>;\n\n  @property({\n    type: \"array\",\n    itemType: \"string\", // 使用itemType指定元素类型\n    default: [], // 直接定义默认值\n  })\n  public labels?: string[];\n\n  @property({\n    type: \"string\",\n    jsonSchema: {\n      format: \"date-time\",\n    },\n  })\n  public create_time?: Date;\n\n  @property({\n    type: \"string\",\n    jsonSchema: {\n      format: \"date-time\",\n    },\n  })\n  public update_time?: Date;\n\n  @property({ type: \"string\" })\n  public update_user?: string;\n\n  @property({ type: \"string\" })\n  public create_user?: string;\n\n  //是否同意图片分析\n  @property({ type: \"boolean\" })\n  public is_imageAnalysis?: boolean;\n\n  @property({ type: \"string\", description: \"内部备注\" })\n  public internal_remark?: string;\n\n  @property({ type: \"string\", description: \"会员编码\" })\n  public member_code?: string;\n\n  @property({\n    type: \"array\",\n    itemType: \"string\", // 使用itemType指定元素类型\n    default: [], // 直接定义默认值\n  })\n  public visitReason?: string[];\n\n  // 会员表单提交记录（历史记录，不影响会员状态判断）\n  @property.array(Object)\n  public member_form_records?: Array<{\n    restaurant_id: string;\n    form_template_id?: string;\n    form_data?: object;\n    submit_time: Date;\n  }>;\n\n  //默认关闭自动同步\n  @property({\n    type: \"boolean\",\n    default: false, // 直接定义默认值\n  })\n  public is_synchronized?: boolean;\n\n  @property({ type: \"boolean\" })\n  public is_first?: boolean;\n\n  //客户已明确拒绝营销信息\n  @property({\n    type: \"boolean\",\n    default: false, // 直接定义默认值\n  })\n  public is_marketing_opt_out?: boolean;\n\n  // WhatsApp营销选择退出，仅阻止WhatsApp营销广告\n  @property({\n    type: \"boolean\",\n    default: false,\n  })\n  public whatsapp_marketing_opt_out?: boolean;\n\n  // WhatsApp退出，阻止所有WhatsApp通知\n  @property({\n    type: \"boolean\",\n    default: false,\n  })\n  public whatsapp_unsubscribed?: boolean;\n\n  //客户允许隐私协议\n  @property({\n    type: \"boolean\",\n    default: false, // 直接定义默认值\n  })\n  public is_privacy_agreement?: boolean;\n\n\n  @property({\n    type: \"array\",\n    itemType: \"string\", // 使用itemType指定元素类型\n    default: [], // 直接定义默认值\n  })\n  public favorite_tables?: string[];\n\n\n  constructor(data?: Partial<CustomerPrivate>) {\n    super(data);\n  }\n}\n\nexport interface ICustomerPrivateRelations {\n  // describe navigational properties here\n}\n\nexport type CustomerPrivateWithRelations = CustomerPrivate &\n  ICustomerPrivateRelations;\n\nexport const CustomerPrivateJsonSchema = getJsonSchema(\n  CustomerPrivate\n) as JsonSchemaRedefined<CustomerPrivate>;\n",
